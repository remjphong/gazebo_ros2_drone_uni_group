<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="farm_5ha">
    <!--
Standalone agricultural test world. Target: Gazebo Sim Harmonic or newer.
Run: gz sim -r farm_5ha.sdf
ENU metres: crop parcel x=[-100,100], y=[-125,125], area=50000 m2=5 ha.
Ground z=0. Crop canopy proxy: HEALTHY green 0.90m; MILD yellow 0.60m;
SEVERE red-orange 0.30m. Colours and height classes are SYNTHETIC labels,
not a biological model. Ordinary lidar cannot classify RGB colour. Use a
nadir RGB camera for colour, downward 3D lidar for height/obstacle geometry.
Tile names encode class and row/column (10m cells); rows run along Y.
Spawn drone near (-119,-151,0.5), above pad top z=0.12; adjust to landing gear.
Charging dock/refill station are static props ONLY. Drone, battery telemetry,
notifications, spraying, fluid dynamics, disease inference and route planning
must be supplied by the vehicle/controller. Water is a visual surface, not fluid.
No Fuel URLs, external meshes, textures or custom plugins required.
GPS origin retained from supplied Baylands world; not a surveyed farm location.
-->
    <physics name="physics_250hz" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
