<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="disease_field">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mặt đất màu xanh (cánh đồng) -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Các khối màu nâu giả lập cây bị sâu bệnh -->
    <model name="disease_patch_1">
      <static>true</static>
      <pose>5 5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 3 1</size></box></geometry>
          <material>
            <ambient>0.3 0.15 0.05 1</ambient>
            <diffuse>0.3 0.15 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="disease_patch_2">
      <static>true</static>
      <pose>-4 6 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 4 1</size></box></geometry>
          <material>
            <ambient>0.4 0.2 0.05 1</ambient>
            <diffuse>0.4 0.2 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="disease_patch_3">
      <static>true</static>
      <pose>2 -3 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 2 1</size></box></geometry>
          <material>
            <ambient>0.35 0.18 0.04 1</ambient>
            <diffuse>0.35 0.18 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
