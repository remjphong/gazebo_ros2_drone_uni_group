<?xml version="1.0" encoding="UTF-8"?>
<!-- Flat obstacle-course world, based on PX4's default world.
     File name must be obstacle_course.sdf (matches the world name below).
     Frame: x = east, y = north, z = up; drone assumed to spawn at (0, 0). -->
<sdf version="1.9">
  <world name="obstacle_course">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -5 0 0 0</pose>
          <geometry>
            <box>
              <size>100000 100000 10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>488</elevation>
    </spherical_coordinates>
    <!-- ===== OBSTACLES =====
         One <model> per obstacle. Keep these in sync with `obstacles:` in
         config/mission.yaml (x = east_m, y = north_m, radius = radius_m). -->
    <model name="obstacle_1">
        <static>true</static>
        <!-- z = height / 2 so the base of the cylinder sits at z = 0 -->
        <pose>5.0 4.0 5.0 0 0 0</pose>

        <link name="link">
          <!-- The real obstacle: radius 1.5 m, 10 m tall so it also blocks
               flights at 5 m altitude. -->
          <collision name="collision">
            <geometry>
              <cylinder>
                <radius>1.5</radius>
                <length>10.0</length>
              </cylinder>
            </geometry>
          </collision>
          <visual name="visual">
            <geometry>
              <cylinder>
                <radius>1.5</radius>
                <length>10.0</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.8 0.2 0.1 1</ambient>
              <diffuse>0.8 0.2 0.1 1</diffuse>
            </material>
          </visual>

          <!-- Planner safety margin (1.0 m): radius 1.5 + 1.0 = 2.5 m.
               Visual only, no collision. The planned path should stay
               outside this ring. -->
          <visual name="safety_margin">
            <geometry>
              <cylinder>
                <radius>2.5</radius>
                <length>0.05</length>
              </cylinder>
            </geometry>
            <pose>0 0 -4.95 0 0 0</pose>
            <material>
              <ambient>1 0.8 0 1</ambient>
              <diffuse>1 0.8 0 1</diffuse>
            </material>
            <transparency>0.6</transparency>
          </visual>
        </link>
      </model>
  </world>
</sdf>
